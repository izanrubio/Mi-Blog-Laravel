---
type QuizQuestion = {
  pregunta: string;
  opciones: string[];
  correcta: number;
  explicacion: string;
};

type Props = {
  quiz: QuizQuestion[];
  lessonId?: string;
  nextHref?: string;
};

const { quiz, lessonId, nextHref = '/curso/' } = Astro.props;
if (!quiz || quiz.length === 0) return;
---

<section class="quiz-wrap">
  <div class="quiz-header">
    <span class="quiz-badge">Quiz</span>
    <h2 class="quiz-title">Pon a prueba lo aprendido</h2>
    <p class="quiz-sub">Responde las preguntas para comprobar que has entendido los conceptos clave.</p>
  </div>

  <div id="quiz-questions">
    {quiz.map((q, qi) => (
      <div
        class="quiz-q"
        data-index={qi}
        data-correcta={q.correcta}
        data-explicacion={q.explicacion}
      >
        <p class="quiz-q-text">
          <span class="q-num">{qi + 1}.</span> {q.pregunta}
        </p>
        <div class="quiz-options">
          {q.opciones.map((op, oi) => (
            <button class="quiz-opt" data-oi={oi}>
              <span class="opt-letter">{String.fromCharCode(65 + oi)}</span>
              <span class="opt-text">{op}</span>
            </button>
          ))}
        </div>
        <div class="quiz-exp" hidden>
          <span id={`exp-text-${qi}`}></span>
        </div>
      </div>
    ))}
  </div>

  <div id="quiz-result" hidden data-lesson-id={lessonId} data-next-href={nextHref}>
    <div class="result-box">
      <p class="result-score" id="result-score"></p>

      <!-- Estado: fallado (<70%) — solo repetir -->
      <div id="result-failed" class="result-state result-state--active">
        <button class="btn-retry-main" id="quiz-retry">Repetir quiz</button>
      </div>

      <!-- Estado: aprobado (≥70%) — marca completada + siguiente + repetir -->
      <div id="result-passed" class="result-state">
        <button id="btn-mark-complete" class="btn-cta-primary">
          Marcar lección como completada
        </button>
        <a id="btn-next-lesson" href={nextHref} class="btn-next">
          Siguiente lección →
        </a>
        <button class="btn-retry-link" id="quiz-retry-passed">repetir quiz</button>
      </div>
    </div>
  </div>
</section>

<script>
  const STORAGE_KEY = 'curso-completado';

  function getCompleted(): string[] {
    try { return JSON.parse(localStorage.getItem(STORAGE_KEY) || '[]'); }
    catch { return []; }
  }

  const questions = Array.from(document.querySelectorAll<HTMLElement>('.quiz-q'));
  let answers: (number | null)[] = new Array(questions.length).fill(null);

  const resultEl = document.getElementById('quiz-result');
  const lessonId = resultEl?.dataset.lessonId ?? '';

  questions.forEach((qEl, qi) => {
    const correcta = parseInt(qEl.dataset.correcta ?? '0');
    const explicacion = qEl.dataset.explicacion ?? '';
    const opts = qEl.querySelectorAll<HTMLButtonElement>('.quiz-opt');
    const exp = qEl.querySelector<HTMLElement>('.quiz-exp');
    const expText = document.getElementById(`exp-text-${qi}`);

    opts.forEach((opt, oi) => {
      opt.addEventListener('click', () => {
        if (answers[qi] !== null) return;

        answers[qi] = oi;
        const isCorrect = oi === correcta;

        opt.classList.add(isCorrect ? 'quiz-opt--correct' : 'quiz-opt--wrong');
        if (!isCorrect) opts[correcta].classList.add('quiz-opt--correct');

        if (exp) exp.hidden = false;
        if (expText) expText.textContent = explicacion;

        opts.forEach(o => { o.disabled = true; });

        if (answers.every(a => a !== null)) showResult();
      });
    });
  });

  function showResult() {
    const correct = answers.filter((a, i) =>
      a === parseInt((questions[i] as HTMLElement).dataset.correcta ?? '0')
    ).length;
    const total = questions.length;
    const passed = correct / total >= 0.7;

    const scoreEl = document.getElementById('result-score');
    if (scoreEl) {
      scoreEl.textContent = passed
        ? `🏆 ¡Quiz superado! Has acertado ${correct} de ${total}`
        : `Has acertado ${correct} de ${total} preguntas — necesitas el 70% para aprobar`;
    }

    if (resultEl) resultEl.hidden = false;
    setResultState(passed && lessonId ? 'passed' : 'failed');

    if (passed && lessonId) applyCompletedState();

    resultEl?.scrollIntoView({ behavior: 'smooth', block: 'nearest' });

    window.dispatchEvent(new CustomEvent('quiz:result', {
      detail: { correct, total, passed }
    }));
  }

  function setResultState(state: 'failed' | 'passed') {
    const failedEl = document.getElementById('result-failed');
    const passedEl = document.getElementById('result-passed');
    failedEl?.classList.toggle('result-state--active', state === 'failed');
    passedEl?.classList.toggle('result-state--active', state === 'passed');
  }

  function applyCompletedState() {
    if (!lessonId || !getCompleted().includes(lessonId)) return;
    const btn = document.getElementById('btn-mark-complete');
    const nextBtn = document.getElementById('btn-next-lesson');
    if (btn) {
      btn.textContent = '✓ Lección completada';
      btn.classList.remove('btn-cta-primary');
      btn.classList.add('btn-done');
      (btn as HTMLButtonElement).disabled = true;
    }
    nextBtn?.classList.add('btn-next--primary');
  }

  document.getElementById('btn-mark-complete')?.addEventListener('click', () => {
    if (!lessonId) return;
    const completed = getCompleted();
    if (!completed.includes(lessonId)) {
      completed.push(lessonId);
      localStorage.setItem(STORAGE_KEY, JSON.stringify(completed));
    }
    window.dispatchEvent(new Event('curso:progress-updated'));
    applyCompletedState();
  });

  function retryQuiz() {
    answers = new Array(questions.length).fill(null);
    questions.forEach((qEl, qi) => {
      const opts = qEl.querySelectorAll<HTMLButtonElement>('.quiz-opt');
      const exp = qEl.querySelector<HTMLElement>('.quiz-exp');
      const expText = document.getElementById(`exp-text-${qi}`);
      opts.forEach(o => { o.className = 'quiz-opt'; o.disabled = false; });
      if (exp) exp.hidden = true;
      if (expText) expText.textContent = '';
    });
    if (resultEl) resultEl.hidden = true;
    setResultState('failed');
    document.getElementById('quiz-questions')?.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  }

  document.getElementById('quiz-retry')?.addEventListener('click', retryQuiz);
  document.getElementById('quiz-retry-passed')?.addEventListener('click', retryQuiz);
</script>

<style>
  .quiz-wrap {
    margin-top: 3rem;
    border-top: 2px solid #f3f4f6;
    padding-top: 2.5rem;
  }

  .quiz-header { margin-bottom: 2rem; }

  .quiz-badge {
    display: inline-block;
    background: rgba(255, 45, 32, 0.1);
    color: #FF2D20;
    padding: 0.25em 0.875em;
    border-radius: 99px;
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    border: 1px solid rgba(255, 45, 32, 0.2);
    margin-bottom: 0.75rem;
  }

  .quiz-title { font-size: 1.25rem; color: #111827; margin: 0 0 0.375rem; }
  .quiz-sub { color: #6b7280; font-size: 0.875rem; margin: 0; }

  /* Question */
  .quiz-q {
    margin-bottom: 2rem;
    padding: 1.25rem;
    background: #f9fafb;
    border-radius: 12px;
    border: 1.5px solid #e5e7eb;
  }

  .quiz-q-text {
    font-size: 0.95rem;
    font-weight: 600;
    color: #111827;
    margin: 0 0 1rem;
    line-height: 1.5;
  }

  .q-num { color: #FF2D20; font-weight: 800; margin-right: 0.25em; }

  .quiz-options { display: flex; flex-direction: column; gap: 0.5rem; }

  .quiz-opt {
    display: flex;
    align-items: flex-start;
    gap: 0.625rem;
    padding: 0.7rem 1rem;
    border: 1.5px solid #e5e7eb;
    border-radius: 8px;
    background: #fff;
    color: #374151;
    font-size: 0.875rem;
    font-family: inherit;
    cursor: pointer;
    text-align: left;
    transition: border-color 0.15s, background 0.15s, color 0.15s;
  }

  .quiz-opt:hover:not(:disabled) {
    border-color: #FF2D20;
    background: #fff5f5;
    color: #FF2D20;
  }

  .quiz-opt:disabled { cursor: default; }

  .opt-letter {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 22px;
    height: 22px;
    background: #f3f4f6;
    border-radius: 4px;
    font-size: 0.72rem;
    font-weight: 700;
    color: #6b7280;
    flex-shrink: 0;
  }

  .opt-text { line-height: 1.4; }

  .quiz-opt--correct {
    border-color: #22c55e !important;
    background: #f0fdf4 !important;
    color: #15803d !important;
  }
  .quiz-opt--correct .opt-letter { background: #22c55e; color: white; }

  .quiz-opt--wrong {
    border-color: #ef4444 !important;
    background: #fef2f2 !important;
    color: #b91c1c !important;
  }
  .quiz-opt--wrong .opt-letter { background: #ef4444; color: white; }

  /* Explanation */
  .quiz-exp {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    margin-top: 0.875rem;
    padding: 0.75rem 1rem;
    background: #eff6ff;
    border-radius: 8px;
    border: 1px solid #bfdbfe;
    color: #1d4ed8;
    font-size: 0.825rem;
    line-height: 1.5;
  }

  /* Result box */
  .result-box {
    padding: 2rem;
    background: #f9fafb;
    border-radius: 12px;
    border: 1.5px solid #e5e7eb;
  }

  .result-score {
    font-size: 1rem;
    font-weight: 700;
    color: #111827;
    margin: 0 0 1.5rem;
    text-align: center;
  }

  /* States — hidden by default, shown via JS class */
  .result-state {
    display: none;
    flex-direction: column;
    align-items: center;
    gap: 0.875rem;
  }
  .result-state--active { display: flex; }

  /* Primary CTA */
  .btn-cta-primary {
    display: block;
    width: 100%;
    padding: 0.9em 1.5em;
    background: #FF2D20;
    color: white;
    border: none;
    border-radius: 10px;
    font-size: 1rem;
    font-weight: 700;
    font-family: inherit;
    cursor: pointer;
    text-align: center;
    text-decoration: none;
    transition: background 0.15s, transform 0.1s;
  }
  .btn-cta-primary:hover { background: #CC2419; color: white; text-decoration: none; transform: translateY(-1px); }

  /* Next lesson — secondary by default, promoted to primary after marking complete */
  .btn-next {
    display: block;
    width: 100%;
    padding: 0.8em 1.5em;
    background: none;
    color: #374151;
    border: 1.5px solid #d1d5db;
    border-radius: 10px;
    font-size: 0.95rem;
    font-weight: 600;
    text-align: center;
    text-decoration: none;
    transition: border-color 0.15s, color 0.15s, background 0.15s;
  }
  .btn-next:hover { border-color: #FF2D20; color: #FF2D20; text-decoration: none; }
  .btn-next--primary { background: #FF2D20; color: white; border-color: #FF2D20; }
  .btn-next--primary:hover { background: #CC2419; color: white; border-color: #CC2419; }

  /* Done state for mark-complete button */
  .btn-done {
    display: block;
    width: 100%;
    padding: 0.9em 1.5em;
    background: #f0fdf4;
    color: #15803d;
    border: 1.5px solid #86efac;
    border-radius: 10px;
    font-size: 1rem;
    font-weight: 700;
    font-family: inherit;
    text-align: center;
    cursor: default;
  }

  /* Retry main — shown when failed */
  .btn-retry-main {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.65em 1.75em;
    background: none;
    color: #374151;
    border: 1.5px solid #d1d5db;
    border-radius: 8px;
    font-size: 0.9rem;
    font-weight: 600;
    font-family: inherit;
    cursor: pointer;
    transition: border-color 0.15s, color 0.15s;
  }
  .btn-retry-main:hover { border-color: #FF2D20; color: #FF2D20; }

  /* Retry link — discrete, shown in passed state */
  .btn-retry-link {
    background: none;
    border: none;
    color: #9ca3af;
    font-size: 0.78rem;
    font-family: inherit;
    cursor: pointer;
    text-decoration: underline;
    padding: 0;
  }
  .btn-retry-link:hover { color: #6b7280; }
</style>
